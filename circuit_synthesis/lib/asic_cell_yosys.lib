library(demo) {
	/* Newer Yosys/ABC versions require a BUF cell in the library to map. */
	cell(BUF) {
		area: 0;
		pin(A) { direction: input; }
		pin(Y) { direction: output; function: "A"; }
	}
	cell(IV) {
		area: 1;
		pin(A) { direction: input; }
		pin(Y) { direction: output; function: "A'"; }
	}
	cell(XOR) {
		area: 1;
		pin(A) { direction: input; }
		pin(B) { direction: input; }
		pin(Y) { direction: output; function: "(A^B)"; }
	}	
	cell(NOR) {
		area: 5;
		pin(A) { direction: input; }
		pin(B) { direction: input; }
		pin(Y) { direction: output; function: "(A+B)'"; }
	}
}
